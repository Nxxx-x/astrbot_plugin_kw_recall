{
  "menu_title": {
    "description": "菜单标题",
    "type": "string",
    "default": "RECALL SETTINGS",
    "hint": "群内发「菜单」时按钮上方那行字。只能在这里改，菜单里没有改标题的按钮；留空则用默认值，换行会压成一行，最多 40 字"
  },
  "notify": {
    "description": "全局提示",
    "type": "bool",
    "default": true,
    "hint": "撤回或禁言后是否发提示并艾特当事人；关闭则只处理、不发言。五类规则的提示文案与刷屏提示都受它控制"
  },
  "keyword": {
    "description": "违禁词撤回",
    "type": "object",
    "hint": "消息包含任一违禁词就撤回，不区分英文大小写",
    "items": {
      "enabled": {
        "description": "启用违禁词撤回",
        "type": "bool",
        "default": true
      },
      "list": {
        "description": "违禁词列表",
        "type": "text",
        "default": "",
        "hint": "一行一个，最多 200 个，每个最长 50 字。建议每个词 2 字以上，太短容易误撤"
      },
      "reply": {
        "description": "提示文案",
        "type": "string",
        "default": "消息含有违禁词，已撤回",
        "hint": "留空表示这一类撤回后不发言"
      }
    }
  },
  "link": {
    "description": "链接撤回",
    "type": "object",
    "hint": "认协议头、www 开头、常见域名后缀和裸 IP；main.py、3.14 这类不算",
    "items": {
      "enabled": {
        "description": "启用链接撤回",
        "type": "bool",
        "default": true
      },
      "reply": {
        "description": "提示文案",
        "type": "string",
        "default": "请勿发送链接，已撤回",
        "hint": "留空表示这一类撤回后不发言"
      }
    }
  },
  "number": {
    "description": "号码撤回",
    "type": "object",
    "hint": "连续 5 位及以上数字视为号码，如 12345、88888；123 45 中间断开不算",
    "items": {
      "enabled": {
        "description": "启用号码撤回",
        "type": "bool",
        "default": true
      },
      "reply": {
        "description": "提示文案",
        "type": "string",
        "default": "请勿发送号码，已撤回",
        "hint": "留空表示这一类撤回后不发言"
      }
    }
  },
  "qrcode": {
    "description": "二维码撤回",
    "type": "object",
    "hint": "下载消息里的图片并用 OpenCV 解码，能读出二维码内容就撤回。需要安装 requirements.txt 里的 opencv-python-headless",
    "items": {
      "enabled": {
        "description": "启用二维码撤回",
        "type": "bool",
        "default": true
      },
      "reply": {
        "description": "提示文案",
        "type": "string",
        "default": "请勿发送二维码，已撤回",
        "hint": "留空表示这一类撤回后不发言"
      }
    }
  },
  "emoji": {
    "description": "Emoji 撤回",
    "type": "object",
    "hint": "只认 😀 ❤️ 👍 这类 Unicode 字符，出现一个就撤；QQ 自带表情（小黄脸、表情包）和 @ 不参与判断",
    "items": {
      "enabled": {
        "description": "启用 Emoji 撤回",
        "type": "bool",
        "default": true
      },
      "reply": {
        "description": "提示文案",
        "type": "string",
        "default": "请勿发送emoji，已撤回",
        "hint": "留空表示这一类撤回后不发言"
      }
    }
  },
  "flood": {
    "description": "刷屏检测",
    "type": "object",
    "hint": "同一成员在 1 秒内发言达到阈值就禁言；需要机器人是群管理员，且只能禁言普通成员",
    "items": {
      "enabled": {
        "description": "启用刷屏检测",
        "type": "bool",
        "default": true
      },
      "threshold": {
        "description": "每秒消息条数阈值",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 0,
          "max": 10,
          "step": 1
        },
        "hint": "拖动选择：1=一秒一条，2=一秒两条，3=一秒三条……10=一秒十条；0 表示不检测"
      },
      "duration": {
        "description": "禁言时长（秒）",
        "type": "int",
        "default": 60,
        "hint": "默认 60 秒；范围 1~2592000（30 天），超出按边界处理"
      },
      "reply": {
        "description": "刷屏提示文案",
        "type": "string",
        "default": "刷屏太快，已禁言 {duration}",
        "hint": "可用 {duration} 占位符，会替换成禁言时长；留空表示禁言后不发言。受「全局提示」控制，开着必艾特"
      }
    }
  }
}
